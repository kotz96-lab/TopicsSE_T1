# Maven
target/
.mvn/wrapper/maven-wrapper.jar.lck

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Upstream BRICS clone — fetched only to vendor sources; not part of our repo.
.upstream/

# PIT historical history file (per-machine cache)
pitHistory.txt

# Coverage / mutation HTML reports are generated artifacts; CI uploads them.
# Keep them out of git.
target/site/jacoco/
target/pit-reports/

# Logs
*.log

# Downloaded third-party binaries kept locally per-developer.
# pict.exe lives here so scripts/generate-pict.ps1 can find it; the
# generated CSVs under pict/generated/ are committed so tests don't
# require PICT to be installed for anyone running mvnw verify.
tools/

# Python bytecode cache (scripts/generate_website.py, scripts/test_generate_website.py)
__pycache__/
*.pyc
