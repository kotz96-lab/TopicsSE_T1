<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>se.topics.t1</groupId>
    <artifactId>brics-evaluation</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>TopicsSE T1 — BRICS evaluation harness</name>
    <description>
        Test, mutation, combinatorial, metamorphic, and differential evaluation
        of the BRICS dk.brics.automaton library. BRICS sources are vendored
        from commit recorded in BRICS_COMMIT (see THIRD_PARTY_NOTICES.txt).
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <junit.version>5.11.3</junit.version>
        <jacoco.version>0.8.12</jacoco.version>
        <pit.version>1.17.0</pit.version>
        <pit.junit5.version>1.2.1</pit.junit5.version>
        <surefire.version>3.5.2</surefire.version>
        <spotbugs.version>4.10.4.0</spotbugs.version>

        <!--
            Classes PIT will mutate. We only want BRICS classes mutated,
            not our test infrastructure under se.topics.t1.*
        -->
        <pit.targetClasses>dk.brics.automaton.*</pit.targetClasses>
        <pit.targetTests>se.topics.t1.*</pit.targetTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Activate with: ./mvnw -Ppit test
            Generates HTML mutation report under target/pit-reports.
        -->
        <profile>
            <id>pit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pit.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pit.junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>${pit.targetClasses}</param>
                            </targetClasses>
                            <targetTests>
                                <param>${pit.targetTests}</param>
                            </targetTests>
                            <!--
                                dk.brics.automaton.Datatypes.buildAll() is build-time-only
                                code: invoked only from main(), it constructs every
                                predefined automaton (XML/XSD types, Unicode blocks and
                                categories) from a companion resource (src/Unicode.txt)
                                that BRICS does not vendor and this repo does not ship.
                                buildAll() and main() are therefore genuinely unreachable
                                here, as are five private helpers buildAll() alone calls
                                (makeCodePoint, buildMap, putWith, putFrom, put). PIT
                                still generates mutants inside them and reports them as
                                "no coverage", which deflates the mutation score with
                                mutants no test suite in this repo could ever kill.

                                PIT's excludedMethods filter matches by method name only
                                (no class qualifier — see PIT's
                                GregorEngineFactory#stringToMethodInfoPredicate, which
                                matches purely on MethodInfo.getName()), so Datatypes'
                                private load()/store() are deliberately NOT excluded
                                here: those names collide with real, tested methods on
                                Automaton, RunAutomaton, and MatchOnlyRunAutomaton, and
                                excluding them would wrongly drop mutation coverage on
                                reachable code. The residual "no coverage" mutants from
                                Datatypes.load()/store()/get() are small and are
                                discussed in docs/mutation-analysis.md instead.
                            -->
                            <excludedMethods>
                                <param>buildAll</param>
                                <param>main</param>
                                <param>makeCodePoint</param>
                                <param>buildMap</param>
                                <param>putWith</param>
                                <param>putFrom</param>
                                <param>put</param>
                            </excludedMethods>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <testPlugin>junit5</testPlugin>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pit-mutation</id>
                                <phase>test</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Activate with: ./mvnw -Pspotbugs verify
            Generates a static-analysis HTML report under
            target/spotbugs.html (assignment §12/§16 — "static-analysis
            reports"). Scoped to the vendored BRICS classes only, same
            as PIT, so findings are about the library under evaluation
            rather than our own test harness.
        -->
        <profile>
            <id>spotbugs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>${spotbugs.version}</version>
                        <configuration>
                            <includeFilterFile>spotbugs-include.xml</includeFilterFile>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <htmlOutput>true</htmlOutput>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs-check</id>
                                <phase>verify</phase>
                                <goals><goal>spotbugs</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
